# Copy to .env.local for local development.
PORT=3000
BIND_HOST=0.0.0.0
# Required for all environments. Use a private password and an independent random secret.
HOTEL_ACCESS_PASSWORD=
HOTEL_ACCESS_COOKIE_SECRET=
# Development: local (127.0.0.1:27017), docker (127.0.0.1:27018), or custom.
MONGODB_MODE=local
# Set MONGODB_URI for a custom development database or for production.
# MONGODB_URI=mongodb://127.0.0.1:27017/hotel-murder-online
